# ============================================================
# College Voting System — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME="College Voting System"
APP_ENV=development
APP_URL=http://localhost/college-voting-system/public
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_voting_db
DB_USER=voting_user
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=cvs_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# File Uploads
UPLOAD_MAX_SIZE=2097152
UPLOAD_DIR=uploads/candidates

# Email (optional — leave empty to disable email notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@college.edu
MAIL_FROM_NAME="College Voting System"
MAIL_ENCRYPTION=tls

# Security
CSRF_TOKEN_LENGTH=32
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=error
LOG_FILE=logs/app.log
