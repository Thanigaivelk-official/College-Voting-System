# =====================================================================
# College Voting System - Root .htaccess
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive directories
    RewriteRule ^(app|database|docs|tests)/ - [F,L,NC]

    # Root redirects to public/
    RewriteRule ^$ public/ [L]

    # Rewrite other requests to public/ only if not already targeting admin or public
    RewriteCond %{REQUEST_URI} !/(admin|public)(/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Block direct access to sensitive file types
<FilesMatch "\.(env|sql|md|json|lock|gitignore|gitattributes|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
